<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" 
         xmlns:xmi="http://schema.omg.org/spec/XMI/20131001"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:uml="http://www.omg.org/spec/UML/20131001"
         xsi:schemaLocation="http://www.omg.org/spec/UML/20131001 http://www.omg.org/spec/UML/20131001/uml.xsd">
         
    <uml:Model xmi:id="_0" name="KELOLA_KARYAWAN_USE_CASE">
        <packagedElement xmi:type="uml:Package" xmi:id="_package_1" name="Kelola Karyawan - Employee Management System">
            
            <!-- ====================================== -->
            <!-- ACTORS (AKTOR) -->
            <!-- ====================================== -->
            
            <!-- Actor 1: Admin / HR Manager -->
            <packagedElement xmi:type="uml:Actor" xmi:id="_actor_admin" name="Admin (HR Manager)">
                <ownedComment xmi:id="_comment_admin">
                    <body>Pengguna dengan akses penuh untuk mengelola seluruh sistem. Dapat melakukan CRUD karyawan, manage user, view history, generate report, dan update profil.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- Actor 2: Karyawan / Employee -->
            <packagedElement xmi:type="uml:Actor" xmi:id="_actor_karyawan" name="Karyawan (Employee)">
                <ownedComment xmi:id="_comment_karyawan">
                    <body>Pengguna dengan akses terbatas. Hanya dapat melihat profil diri sendiri, informasi gaji, dan generate ID card.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- USE CASES - AUTHENTICATION -->
            <!-- ====================================== -->
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_login" name="UC-01: Login">
                <ownedComment xmi:id="_comment_uc01">
                    <body>User memasukkan email dan password untuk melakukan otentikasi ke sistem. Sistem memvalidasi kredensial dan mengarahkan user ke dashboard sesuai role (Admin atau Karyawan).</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_logout" name="UC-02: Logout">
                <ownedComment xmi:id="_comment_uc02">
                    <body>User melakukan logout dari sistem. Session dihapus dan user diarahkan ke halaman login.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- USE CASES - ADMIN KARYAWAN MANAGEMENT -->
            <!-- ====================================== -->
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_dashboard" name="UC-03: View Dashboard">
                <ownedComment xmi:id="_comment_uc03">
                    <body>Admin melihat dashboard dengan statistik kepegawaian (total karyawan, aktif, non-aktif, breakdown per divisi).</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_filter_karyawan" name="UC-04: Filter dan Sort Karyawan">
                <ownedComment xmi:id="_comment_uc04">
                    <body>Admin memfilter karyawan berdasarkan: huruf awal nama (A-Z), NIK, divisi, jenis kelamin, status (aktif/non-aktif), gaji range. Admin juga dapat melakukan sorting berdasarkan nama, NIK, gaji, divisi, tanggal. Hasil ditampilkan dengan pagination.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_karyawan_list" name="UC-05: View List Karyawan">
                <ownedComment xmi:id="_comment_uc05">
                    <body>Admin melihat list karyawan dalam bentuk tabel dengan informasi nama, NIK, divisi, posisi, gaji, status. Hanya menampilkan karyawan yang tidak dihapus (deleted_at IS NULL).</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_karyawan_detail" name="UC-06: View Detail Karyawan">
                <ownedComment xmi:id="_comment_uc06">
                    <body>Admin melihat detail lengkap satu karyawan termasuk foto, informasi pribadi (nama, NIK, alamat, no telepon, tempat lahir, tanggal lahir, pendidikan, jenis kelamin), informasi kerja (divisi, posisi, gaji, status, keterangan).</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_create_karyawan" name="UC-07: Tambah Karyawan Baru">
                <ownedComment xmi:id="_comment_uc07">
                    <body>Admin menambah karyawan baru dengan mengisi form: nama, NIK (unique), divisi, posisi, gaji, status, alamat, no telepon, tempat lahir, tanggal lahir, pendidikan, jenis kelamin, keterangan, foto. Sistem memvalidasi input, upload foto, create record di tabel karyawans, dan auto-log ke karyawan_histories dengan action='create'.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_edit_karyawan" name="UC-08: Edit Data Karyawan">
                <ownedComment xmi:id="_comment_uc08">
                    <body>Admin mengedit data karyawan yang sudah ada. Sistem menyimpan old_data sebelum update, lalu melakukan update ke tabel karyawans, dan auto-log ke karyawan_histories dengan action='update' mencakup old_data dan new_data yang berubah.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_delete_karyawan" name="UC-09: Hapus/Deaktifkan Karyawan">
                <ownedComment xmi:id="_comment_uc09">
                    <body>Admin melakukan soft delete pada karyawan (set deleted_at = current_timestamp). Data tidak benar-benar dihapus dari database. Sistem auto-log ke karyawan_histories dengan action='delete' mencakup seluruh old_data karyawan yang dihapus.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- USE CASES - ADMIN USER MANAGEMENT -->
            <!-- ====================================== -->
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_users" name="UC-10: View List User">
                <ownedComment xmi:id="_comment_uc10">
                    <body>Admin melihat list semua user dalam sistem dengan informasi nama, email, role (tersirat dari karyawan_id). Admin dapat search dan sort user.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_create_user" name="UC-11: Tambah User Baru">
                <ownedComment xmi:id="_comment_uc11">
                    <body>Admin membuat user baru dengan nama, email (unique), password. Jika karyawan_id null = Admin, jika karyawan_id filled = Karyawan. Sistem auto-log ke user_histories dengan action='create'.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_edit_user" name="UC-12: Edit User">
                <ownedComment xmi:id="_comment_uc12">
                    <body>Admin mengedit user (nama, email, password). Sistem menyimpan old_data sebelum update dan auto-log ke user_histories dengan action='update' jika ada perubahan. Password terenkripsi di database.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_delete_user" name="UC-13: Hapus User">
                <ownedComment xmi:id="_comment_uc13">
                    <body>Admin menghapus user dari sistem. Admin tidak dapat menghapus akun diri sendiri (untuk mencegah lock-out). Sistem auto-log ke user_histories dengan action='delete' sebelum menghapus.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- USE CASES - ADMIN REPORTING & EXPORT -->
            <!-- ====================================== -->
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_generate_report" name="UC-14: Generate Report / Export PDF">
                <ownedComment xmi:id="_comment_uc14">
                    <body>Admin generate laporan karyawan dalam format PDF. Admin dapat memilih export selected karyawan atau all karyawan. Report mencakup informasi lengkap karyawan dan history perubahan data. File PDF di-download atau di-stream ke browser.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_preview_report" name="UC-15: Preview Report">
                <ownedComment xmi:id="_comment_uc15">
                    <body>Admin melihat preview report satu karyawan di browser sebelum mengexport ke PDF. Preview mencakup detail karyawan dan history perubahan data.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- USE CASES - ADMIN AUDIT TRAIL -->
            <!-- ====================================== -->
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_history" name="UC-16: View Audit Trail / History">
                <ownedComment xmi:id="_comment_uc16">
                    <body>Admin melihat history semua perubahan data yang tercatat di sistem. Mencakup karyawan_histories dan user_histories. Admin dapat filter berdasarkan action (create, update, delete), search berdasarkan nama karyawan atau email user, sort berdasarkan kolom tertentu, dan pagination. Setiap entry menampilkan: siapa yang mengubah, kapan diubah, apa yang diubah (old_data vs new_data).</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- USE CASES - ADMIN PROFILE MANAGEMENT -->
            <!-- ====================================== -->
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_admin_profile" name="UC-17: View Admin Profile">
                <ownedComment xmi:id="_comment_uc17">
                    <body>Admin melihat profil diri sendiri termasuk nama, email, phone, address.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_edit_admin_profile" name="UC-18: Edit Admin Profile">
                <ownedComment xmi:id="_comment_uc18">
                    <body>Admin mengubah data profil diri sendiri (nama, email, phone, address). Sistem memvalidasi bahwa email unik (tidak sama dengan user lain).</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_change_password" name="UC-19: Change Password">
                <ownedComment xmi:id="_comment_uc19">
                    <body>Admin mengubah password. Sistem memvalidasi current_password sesuai dengan password yang tersimpan (hashed dengan bcrypt). Password baru minimal 8 karakter dan harus confirmed.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- USE CASES - KARYAWAN FEATURES -->
            <!-- ====================================== -->
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_karyawan_dashboard" name="UC-20: View Karyawan Dashboard">
                <ownedComment xmi:id="_comment_uc20">
                    <body>Karyawan melihat dashboard/profil pribadi dengan informasi lengkap: foto, nama, NIK, divisi, posisi, gaji, status, alamat, no telepon, tempat lahir, tanggal lahir, pendidikan, jenis kelamin. Juga menampilkan recent history perubahan data (10 entries terakhir). Akses read-only, tidak bisa edit.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_view_karyawan_profile" name="UC-21: View Karyawan Profile">
                <ownedComment xmi:id="_comment_uc21">
                    <body>Karyawan melihat halaman profil detail dengan informasi pribadi dan informasi kerja lengkap. Sama seperti dashboard tapi dalam halaman terpisah. Read-only access.</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:UseCase" xmi:id="_usecase_generate_id_card" name="UC-22: Generate ID Card">
                <ownedComment xmi:id="_comment_uc22">
                    <body>Karyawan generate ID card PDF yang berisi foto, nama, NIK, divisi, posisi. PDF di-generate menggunakan DomPDF, di-format A4 landscape dengan margin 5mm. Karyawan dapat download atau print langsung dari browser. Hanya pemilik karyawan atau admin yang dapat generate ID card.</body>
                </ownedComment>
            </packagedElement>
            
            <!-- ====================================== -->
            <!-- ASSOCIATIONS / RELATIONSHIPS -->
            <!-- ====================================== -->
            
            <!-- Admin Uses -->
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_login" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_login"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_logout" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_logout"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_dashboard" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_view_dashboard"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_filter" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_filter_karyawan"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_list" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_view_karyawan_list"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_detail" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_view_karyawan_detail"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_create" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_create_karyawan"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_edit" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_edit_karyawan"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_delete" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_delete_karyawan"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_users" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_view_users"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_create_user" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_create_user"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_edit_user" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_edit_user"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_delete_user" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_delete_user"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_report" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_generate_report"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_preview" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_preview_report"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_history" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_view_history"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_profile" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_view_admin_profile"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_edit_profile" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_edit_admin_profile"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_admin_password" name="">
                <memberEnd xmi:idref="_actor_admin"/>
                <memberEnd xmi:idref="_usecase_change_password"/>
            </packagedElement>
            
            <!-- Karyawan Uses -->
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_karyawan_login" name="">
                <memberEnd xmi:idref="_actor_karyawan"/>
                <memberEnd xmi:idref="_usecase_login"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_karyawan_logout" name="">
                <memberEnd xmi:idref="_actor_karyawan"/>
                <memberEnd xmi:idref="_usecase_logout"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_karyawan_dashboard" name="">
                <memberEnd xmi:idref="_actor_karyawan"/>
                <memberEnd xmi:idref="_usecase_view_karyawan_dashboard"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_karyawan_profile" name="">
                <memberEnd xmi:idref="_actor_karyawan"/>
                <memberEnd xmi:idref="_usecase_view_karyawan_profile"/>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Association" xmi:id="_assoc_karyawan_idcard" name="">
                <memberEnd xmi:idref="_actor_karyawan"/>
                <memberEnd xmi:idref="_usecase_generate_id_card"/>
            </packagedElement>
            
            <!-- Include Relationships / Dependencies -->
            <packagedElement xmi:type="uml:Dependency" xmi:id="_include_filter_to_list" name="include">
                <supplier xmi:idref="_usecase_view_karyawan_list"/>
                <client xmi:idref="_usecase_filter_karyawan"/>
                <ownedComment xmi:id="_comment_include_filter">
                    <body>Filter operation includes View List Karyawan use case</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Dependency" xmi:id="_include_detail_to_list" name="include">
                <supplier xmi:idref="_usecase_view_karyawan_list"/>
                <client xmi:idref="_usecase_view_karyawan_detail"/>
                <ownedComment xmi:id="_comment_include_detail">
                    <body>View Detail includes access to List to select karyawan</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Dependency" xmi:id="_extend_edit_to_detail" name="extend">
                <supplier xmi:idref="_usecase_view_karyawan_detail"/>
                <client xmi:idref="_usecase_edit_karyawan"/>
                <ownedComment xmi:id="_comment_extend_edit">
                    <body>Edit Karyawan extends View Detail when admin clicks edit button</body>
                </ownedComment>
            </packagedElement>
            
            <packagedElement xmi:type="uml:Dependency" xmi:id="_include_dashboard_to_list" name="include">
                <supplier xmi:idref="_usecase_view_karyawan_list"/>
                <client xmi:idref="_usecase_view_dashboard"/>
                <ownedComment xmi:id="_comment_include_dashboard">
                    <body>View Dashboard includes View List Karyawan as base content</body>
                </ownedComment>
            </packagedElement>
            
        </packagedElement>
    </uml:Model>
</xmi:XMI>